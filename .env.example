# Copy these into your server environment (or export them in your shell).
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=put-a-long-random-string-here
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com
DJANGO_SSL_REDIRECT=True

# Database: "sqlite" (default, development) or "postgres" (production)
DB_ENGINE=postgres
DB_NAME=bardhere_hb
DB_USER=bardhere_hb
DB_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5432

# Email (booking confirmations). Default prints emails to the console.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=bookings@yourdomain.com
